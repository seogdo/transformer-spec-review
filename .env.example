# Copy this file to .env locally. Never commit .env or paste credentials in chat.
# A browser page is NOT the place to enter an API key.
LLM_BACKEND=openai
OPENAI_API_KEY=
# Required: a model your OpenAI account can access with Chat Completions and
# Structured Outputs. The course ZIP examples use gpt-4o-mini / gpt-4o;
# those examples are not a guarantee of access or a new performance result.
OPENAI_MODEL=

# Used only with --backend ollama. No automatic download or provider fallback.
HANDOFF_OLLAMA_MODEL=qwen3.5:2b
HANDOFF_OLLAMA_URL=http://127.0.0.1:11434
